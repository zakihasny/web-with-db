# Required in production. Keep database credentials server-side.
DATABASE_URL=postgresql://username:password@neo-db-host:5432/asset_compliance?sslmode=verify-full
CRON_SHARED_SECRET=replace-with-a-long-random-secret

# NEO App runtime settings.
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
RUN_DB_MIGRATIONS=true

# Enables representative read-only data when PostgreSQL is unavailable locally.
# Never enable this in production.
DEMO_MODE=false
